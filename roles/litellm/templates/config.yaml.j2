# Managed by Ansible (roles/litellm). Edit litellm_models / litellm_fallbacks in roles/litellm/defaults/main.yaml.
# How to switch models on each machine: docs/ai-model-switching.md.
general_settings:
  master_key: "{{ litellm_master_key }}"

litellm_settings:
  drop_params: true       # clients send params some backends (LM Studio, oMLX) reject
  telemetry: false

router_settings:
  # Skip any deployment whose max_input_tokens the prompt would exceed (it goes to the fallback instead).
  enable_pre_call_checks: true
  num_retries: {{ litellm_num_retries }}
  cooldown_time: {{ litellm_cooldown_time }}
  allowed_fails_policy:
    TimeoutErrorAllowedFails: 0
    InternalServerErrorAllowedFails: 1
    ServiceUnavailableErrorAllowedFails: 1
    BadGatewayErrorAllowedFails: 1
  fallbacks:
{% for f in litellm_fallbacks %}
    - "{{ f.model }}": {{ f.to | to_json }}
{% endfor %}

model_list:
{% for m in litellm_models %}
  - model_name: "{{ m.name }}"
    litellm_params:
      model: "{{ m.provider | default('openai') }}/{{ m.model }}"
      api_base: "{{ m.api_base }}"
      api_key: "{{ m.api_key | default('none') }}"
{% if m.timeout is defined %}
      timeout: {{ m.timeout }}
{% endif %}
{% if m.stream_timeout is defined %}
      stream_timeout: {{ m.stream_timeout }}
{% endif %}
{% if m.max_input_tokens is defined %}
    model_info:
      max_input_tokens: {{ m.max_input_tokens }}
{% endif %}
{% endfor %}
