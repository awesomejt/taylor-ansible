general_settings:
  master_key: "{{ litellm_master_key }}"

router_settings:
  fallbacks:
    - "{{ litellm_omlx_primary_model_name }}":
        - "{{ litellm_omlx_secondary_model_name }}"
        - "{{ litellm_model_name }}"
    - "{{ litellm_omlx_secondary_model_name }}":
        - "{{ litellm_omlx_primary_model_name }}"
        - "{{ litellm_model_name }}"
    - "{{ litellm_model_name }}":
        - "{{ litellm_omlx_primary_model_name }}"
        - "{{ litellm_omlx_secondary_model_name }}"
    - "{{ litellm_alias_chat }}":
        - "omlx-secondary-chat"
        - "ws2-lmstudio-chat"
        - "ollama-chat"
    - "{{ litellm_alias_coding }}":
        - "omlx-secondary-coding"
        - "ws2-lmstudio-coding"
        - "ollama-coding"
    - "{{ litellm_alias_thinking }}":
        - "omlx-secondary-thinking"
        - "ws2-lmstudio-thinking"
        - "ollama-thinking"
    - "omlx-primary-chat":
        - "omlx-secondary-chat"
        - "ollama-chat"
    - "omlx-secondary-chat":
        - "ws2-lmstudio-chat"
        - "ollama-chat"
    - "omlx-primary-coding":
        - "omlx-secondary-coding"
        - "ollama-coding"
    - "omlx-secondary-coding":
        - "ws2-lmstudio-coding"
        - "ollama-coding"
    - "omlx-primary-thinking":
        - "omlx-secondary-thinking"
        - "ollama-thinking"
    - "omlx-secondary-thinking":
        - "ws2-lmstudio-thinking"
        - "ollama-thinking"
    - "{{ litellm_homelab_orchestrator_alias }}":
      - "{{ litellm_homelab_coder_alias }}"
      - "{{ litellm_homelab_research_alias }}"
      - "{{ litellm_homelab_deterministic_alias }}"
    - "{{ litellm_homelab_coder_alias }}":
      - "{{ litellm_homelab_thinker_alias }}"
      - "{{ litellm_homelab_research_alias }}"
      - "{{ litellm_homelab_deterministic_alias }}"
    - "{{ litellm_homelab_thinker_alias }}":
      - "{{ litellm_homelab_research_alias }}"
      - "{{ litellm_homelab_deterministic_alias }}"
    - "{{ litellm_homelab_research_alias }}":
      - "{{ litellm_homelab_deterministic_alias }}"

model_list:
  - model_name: "{{ litellm_alias_chat }}"
    litellm_params:
      model: "openai/{{ litellm_omlx_primary_chat_model }}"
      api_base: "{{ litellm_omlx_primary_base_url }}"
      api_key: "{{ litellm_omlx_api_key }}"
  - model_name: "{{ litellm_alias_coding }}"
    litellm_params:
      model: "openai/{{ litellm_omlx_primary_coding_model }}"
      api_base: "{{ litellm_omlx_primary_base_url }}"
      api_key: "{{ litellm_omlx_api_key }}"
  - model_name: "{{ litellm_alias_thinking }}"
    litellm_params:
      model: "openai/{{ litellm_omlx_primary_thinking_model }}"
      api_base: "{{ litellm_omlx_primary_base_url }}"
      api_key: "{{ litellm_omlx_api_key }}"
  - model_name: "omlx-primary-chat"
    litellm_params:
      model: "openai/{{ litellm_omlx_primary_chat_model }}"
      api_base: "{{ litellm_omlx_primary_base_url }}"
